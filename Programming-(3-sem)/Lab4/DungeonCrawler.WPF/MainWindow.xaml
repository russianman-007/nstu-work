<Window x:Class="DungeonCrawler.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DungeonCrawler.WPF.ViewModels"
        Title="ИСКАТЕЛЬ ПОДЗЕМЕЛИЙ" 
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Background="#1E1E1E">

    <Window.DataContext>
        <vm:GameViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="GameCellButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="#1E1E1E" BorderThickness="0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#3E3E3E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="3"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4E4E4E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Игровое поле -->
        <GroupBox Grid.Column="0" Header="Игровое поле" Margin="10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" 
                  VerticalScrollBarVisibility="Auto"
                  Background="#2D2D2D">
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DungeonWidth}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GameCellButton}"
                            Content="{Binding Content}"
                            Background="{Binding BackgroundColor}"
                            Foreground="{Binding ForegroundColor}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- Правая панель -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Статус -->
            <GroupBox Grid.Row="0" Header="Статус">
                <TextBlock Text="{Binding StatusText}" 
                           FontSize="14" 
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="#00FF00"/>
            </GroupBox>

            <!-- Легенда -->
            <GroupBox Grid.Row="1" Header="Легенда">
                <StackPanel>
                    <TextBlock Text="@ = Герой" Margin="2" Foreground="#FFD700"/>
                    <TextBlock Text="$ = Сокровище" Margin="2" Foreground="#00FF00"/>
                    <TextBlock Text="S = Стоячий враг" Margin="2" Foreground="#FF0000"/>
                    <TextBlock Text="M = Движущийся враг" Margin="2" Foreground="#FF00FF"/>
                    <TextBlock Text="# = Стена" Margin="2" Foreground="#808080"/>
                    <TextBlock Text="E = Выход" Margin="2" Foreground="#00FFFF"/>
                </StackPanel>
            </GroupBox>

            <!-- Журнал событий -->
            <GroupBox Grid.Row="2" Header="Журнал">
                <ListBox ItemsSource="{Binding LogMessages}" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontSize="11"
                         Background="#2D2D2D"
                         Foreground="#FFFFFF"/>
            </GroupBox>

            <!-- Кнопки управления -->
            <GroupBox Grid.Row="3" Header="Управление" Margin="0,5,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Новая игра (N)" Command="{Binding NewGameCommand}" 
                Style="{StaticResource ActionButton}" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="Сохранить (F5)" Command="{Binding SaveGameCommand}" 
                Style="{StaticResource ActionButton}" Margin="4,0,4,0"/>
                    <Button Grid.Column="2" Content="Загрузить (F9)" Command="{Binding LoadGameCommand}" 
                Style="{StaticResource ActionButton}" Margin="4,0,0,0"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>